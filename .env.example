# ============================================================
# 邻里流转 · 环境变量样例
# 复制为 .env 后按需修改：`cp .env.example .env`
# 注意：`prisma migrate|seed|generate` 前必须设置 DATABASE_URL，否则报 P1012。
# ============================================================

# PostgreSQL 连接串（与 docker-compose.yml 的 db 服务一致）
# 若本机 5432 端口已被其它程序占用：在本地 .env 里设 DB_PORT=55433，
# 并把下面连接串的端口同步改成 55433（docker compose 会自动读取 .env 的 DB_PORT）。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community?schema=public"

# 可选：docker-compose 映射到宿主机的 PG 端口（默认 5432）
# DB_PORT="5432"

# 会话签名密钥（生产环境请替换为足够长的随机串）
SESSION_SECRET="dev-only-session-secret-change-me"

# LLM 网关（OpenAI 兼容协议；缺失 LLM_API_KEY 时直接走规则降级，HTTP 仍 200）
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"
# 单轮模型调用**上限**（毫秒），缺省 22000。
# ⚠️ 不要按「6 秒够用」的直觉调小：实测带 tools 的单轮往返为 1.7 / 15.1 / 16.2 / 20.7 秒，
#    4 次里 3 次 > 15s。配成 6000 会让定价 agent 的主路径被自己的超时稳定掐死、
#    永远拿不到 source:'llm'，表现为「接口很慢且总是 degraded」。
LLM_TIMEOUT_MS="22000"

# 图运行时总预算 / 工具轮次上限 / 进入 REPAIR 所需的最低余量。
# 部署到远端时 LLM_DEADLINE_MS 应设为**宿主请求上限的 80%**，否则宿主会先断连。
# 这三个此前只存在于代码默认值里，没进本文件——改它们要翻源码，属于文档缺口。
LLM_DEADLINE_MS="60000"
LLM_MAX_TOOL_ROUNDS="2"
LLM_REPAIR_FLOOR_MS="4000"

# 定价保险模式（服务端预取社区成交行情）：1 = 开（默认），0 = 关
AI_PRICING_PREFETCH="1"

# 语义检索的嵌入供应商（OpenAI 兼容 /embeddings），与 LLM_* **相互独立**，可指向不同中转。
# 不配 EMBEDDING_API_KEY 时检索工具自动摘除：定价仍用聚合行情，source:'llm'、degraded:false，
# 不会退化成规则结果（§6.5.7 F4「局部摘除单个工具」）。
#
# 现用 bge-m3（多语言、中文强，8192 token 远超本项目语料）。注意 DeepSeek **没有**
# embeddings 端点，所以这把 Key 不能和 LLM_API_KEY 混用。
EMBEDDING_BASE_URL="https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="BAAI/bge-m3"
# ⚠️ 必须等于迁移里的列宽（当前 vector(1024)，见迁移 0003 + 0004）：`embeddings.ts`
# 会按这个值硬校验返回向量长度，不符直接抛 EmbeddingUnavailableError。
# 换成非 1024 维的模型（如 OpenAI text-embedding-3-small 的 1536）= 一次新迁移 +
# `npm run db:embed` 全量回填；只改这里不改迁移会造成「写入 / 查询维度不一致」的静默错位。
# 另：pgvector 的 HNSW/IVFFlat 索引上限 2000 维，别选 >2000 维的模型。
EMBEDDING_DIM="1024"
# 单次嵌入请求超时（毫秒），缺省 8000。
EMBEDDING_TIMEOUT_MS="8000"

# 图片本地落盘目录（StorageAdapter 默认实现）
UPLOAD_DIR="./public/uploads"

# 日志级别：debug | info | warn | error（缺省 info）。排障时设 debug。
# error 走 stderr、其余走 stdout，便于容器编排按流分流。
LOG_LEVEL="info"
