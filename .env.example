# ============================================================
# 邻里流转 · 环境变量样例
# 复制为 .env 后按需修改：`cp .env.example .env`
# 注意：`prisma migrate|seed|generate` 前必须设置 DATABASE_URL，否则报 P1012。
# ============================================================

# PostgreSQL 连接串（与 docker-compose.yml 的 db 服务一致）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/community?schema=public"

# 会话签名密钥（生产环境请替换为足够长的随机串）
SESSION_SECRET="dev-only-session-secret-change-me"

# LLM 网关（OpenAI 兼容协议；缺失 LLM_API_KEY 时直接走规则降级，HTTP 仍 200）
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"

# 定价保险模式（服务端预取社区成交行情）：1 = 开（默认），0 = 关
AI_PRICING_PREFETCH="1"

# 图片本地落盘目录（StorageAdapter 默认实现）
UPLOAD_DIR="./public/uploads"
